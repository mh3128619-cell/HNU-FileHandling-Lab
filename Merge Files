import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;

public class MergeFiles {
    public static void main(String[] args) {
        try {
            BufferedWriter writer = new BufferedWriter(new FileWriter("merged.txt"));

            String[] filesToMerge = {"file1.txt", "file2.txt"};

            for (String fileName : filesToMerge) {
                BufferedReader reader = new BufferedReader(new FileReader(fileName));
                String line;
                while ((line = reader.readLine()) != null) {
                    writer.write(line);
                    writer.newLine();
                }
                reader.close();
            }

            writer.close();
            System.out.println("Files merged successfully into merged.txt");
        } catch (IOException e) {
            System.out.println("An error occurred during merging.");
            e.printStackTrace();
        }
    }
}
